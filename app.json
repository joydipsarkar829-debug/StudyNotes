{
  "expo": {
    "name": "Study Notes",
    "slug": "StudyNotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "studynotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joydip.studyNotes"
    },
    "android": {
      "package": "com.joydip.studyNotes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#4A90D9"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ]
  }
}
